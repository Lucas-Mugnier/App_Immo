# Supabase — à remplir après création du projet sur https://supabase.com
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXX

# Ton adresse email — seul ce compte voit l'onglet Admin et le bouton "Actualiser"
VITE_ADMIN_EMAIL=toi@example.com

# Ces deux-là sont utilisées uniquement côté serveur par api/refresh.ts
# (à configurer comme variables d'environnement Vercel, PAS dans ce fichier
# .env.local puisqu'elles ne doivent jamais atteindre le bundle client) :
#   ADMIN_EMAIL=toi@example.com                     (doit correspondre à VITE_ADMIN_EMAIL)
#   GITHUB_TOKEN=<PAT fine-grained, scope Actions read/write sur ce repo>
